<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TimeFly.Core\TimeFly.Core.csproj" />
    <ProjectReference Include="..\TimeFly.Data\TimeFly.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TimeFly.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <RollForward>LatestMajor</RollForward>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\app_icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\app_icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\otd_tablets.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Windows App SDK 1.8 + current dotnet publish can omit compiled XAML for unpackaged apps. -->
  <Target Name="CopyPublishedXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <_TimeFlyXamlResources Include="$(OutputPath)**\*.xbf" />
      <_TimeFlyXamlResources Include="$(OutputPath)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_TimeFlyXamlResources)"
      DestinationFiles="@(_TimeFlyXamlResources->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
