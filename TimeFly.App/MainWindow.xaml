<Window
    x:Class="TimeFly.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource TimeFlyWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- App Title Bar -->
        <Grid x:Name="AppTitleBar" Height="46" Padding="18,0,180,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Width="18" Height="18" Source="Assets/app_icon.png" />
                <TextBlock Text="TimeFly" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock
                    Text="Art Tracker"
                    FontSize="11"
                    Foreground="{StaticResource TimeFlyMutedTextBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Main Navigation with Left Docked Pane -->
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsSettingsVisible="True"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="Left"
            CompactPaneLength="48"
            OpenPaneLength="215"
            SelectionChanged="Navigation_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Live Tracker" Tag="tracker">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEC4A;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Analytics" Tag="analytics">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Artworks" Tag="artworks">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Kanban Board" Tag="kanban">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xF168;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="history">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Curved Modern Content Container -->
            <Border
                Background="{StaticResource TimeFlyContentBackgroundBrush}"
                BorderBrush="{StaticResource TimeFlyContentBorderBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Grid>
                    <Frame x:Name="ContentFrame" />
                    <InfoBar
                        x:Name="UpdateNotificationBar"
                        IsOpen="False"
                        Severity="Informational"
                        VerticalAlignment="Top"
                        Margin="24,18,24,0"
                        CornerRadius="8"
                        IsClosable="True">
                        <InfoBar.ActionButton>
                            <Button Content="Download Update" Click="DownloadUpdate_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </Grid>
            </Border>
        </NavigationView>
    </Grid>
</Window>
