<Application
    x:Class="TimeFly.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme Color Palette (Studio Graphite & Electric Azure - 0% Cliché Purple) -->
            <Color x:Key="TimeFlyAccentColor">#38BDF8</Color>
            <SolidColorBrush x:Key="TimeFlyAccentBrush" Color="{StaticResource TimeFlyAccentColor}" />
            <SolidColorBrush x:Key="TimeFlyWindowBackgroundBrush" Color="#0B0C0E" />
            <SolidColorBrush x:Key="TimeFlyContentBackgroundBrush" Color="#121316" />
            <SolidColorBrush x:Key="TimeFlyContentBorderBrush" Color="#22242B" />
            <SolidColorBrush x:Key="TimeFlyCardBrush" Color="#18191E" />
            <SolidColorBrush x:Key="TimeFlyCardBackgroundBrush" Color="#18191E" />
            <SolidColorBrush x:Key="TimeFlyCardBorderBrush" Color="#272A32" />
            <SolidColorBrush x:Key="TimeFlyMutedTextBrush" Color="#8E929E" />
            <SolidColorBrush x:Key="TimeFlySubtleTextBrush" Color="#5A5E6B" />
            <SolidColorBrush x:Key="TimeFlyTimeBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="TimeFlyBadgeBackgroundBrush" Color="#1E2028" />
            <SolidColorBrush x:Key="TimeFlyBadgeTextBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="TimeFlyIconBoxBrush" Color="#1E2028" />

            <!-- Card Style -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource TimeFlyCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TimeFlyCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <!-- Compact Card Style -->
            <Style x:Key="CompactCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource TimeFlyCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TimeFlyCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
