<Page x:Class="TimeFly.App.Views.AnalyticsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer><StackPanel Padding="36,28,36,40" Spacing="20">
        <Grid><StackPanel Spacing="4"><TextBlock Text="Studio Analytics" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Your drawing rhythm, projects, and focus patterns." Foreground="{StaticResource TimeFlyMutedTextBrush}"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72C;"/><TextBlock Text="Refresh"/></StackPanel></Button></Grid>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="7"><TextBlock Text="Total drawing" Foreground="{StaticResource TimeFlyMutedTextBrush}"/><TextBlock x:Name="TotalText" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Focused time" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="7"><TextBlock Text="Drawing sessions" Foreground="{StaticResource TimeFlyMutedTextBrush}"/><TextBlock x:Name="SessionCountText" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="FocusBlocksCountText" Text="0 focus blocks" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel Spacing="7"><TextBlock Text="Active days" Foreground="{StaticResource TimeFlyMutedTextBrush}"/><TextBlock x:Name="ActiveDaysText" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Days creating" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource CardStyle}"><StackPanel Spacing="7"><TextBlock Text="Streak" Foreground="{StaticResource TimeFlyMutedTextBrush}"/><TextBlock x:Name="StreakText" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Consecutive days" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}"/></StackPanel></Border>
        </Grid>
        <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="Past 7 days" FontSize="16" FontWeight="SemiBold"/><ItemsControl x:Name="DailyList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}"/><ProgressBar Grid.Column="1" Maximum="100" Value="{Binding Percent}" Height="8" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Duration}" HorizontalAlignment="Right" Foreground="{StaticResource TimeFlyMutedTextBrush}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="Top artworks" FontSize="16" FontWeight="SemiBold"/><ItemsControl x:Name="ProjectsList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4" Spacing="5"><Grid><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Duration}" HorizontalAlignment="Right" Foreground="{StaticResource TimeFlyMutedTextBrush}"/></Grid><ProgressBar Maximum="100" Value="{Binding Percent}" Height="6"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        </Grid>
        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><StackPanel Spacing="3"><TextBlock Text="Activity by hour" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="When you most often draw" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}"/></StackPanel><GridView x:Name="HourlyGrid" IsItemClickEnabled="False" SelectionMode="None" HorizontalAlignment="Stretch"><GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid MaximumRowsOrColumns="12" Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel><GridView.ItemTemplate><DataTemplate><Border Width="66" Height="56" Margin="3" CornerRadius="7" Background="{Binding Brush}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding Hour}" FontWeight="SemiBold"/><TextBlock Text="{Binding Duration}" FontSize="10" Opacity="0.75"/></StackPanel></Border></DataTemplate></GridView.ItemTemplate></GridView></StackPanel></Border>
    </StackPanel></ScrollViewer>
</Page>
