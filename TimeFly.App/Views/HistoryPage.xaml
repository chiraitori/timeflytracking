<Page x:Class="TimeFly.App.Views.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="36,28,36,40" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><StackPanel Spacing="4"><TextBlock Text="Session History" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Foreground="{StaticResource TimeFlyMutedTextBrush}"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBox x:Name="SearchBox" Width="220" PlaceholderText="Search canvas, tags, notes…" TextChanged="Filter_Changed"/><ComboBox x:Name="DateFilter" Width="130" SelectionChanged="Filter_Changed"><x:String>All time</x:String><x:String>Today</x:String><x:String>Past 7 days</x:String><x:String>Past 30 days</x:String></ComboBox><Button Click="Edit_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70F;"/><TextBlock Text="Edit"/></StackPanel></Button><Button Click="Delete_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;"/><TextBlock Text="Delete"/></StackPanel></Button><Button Click="Export_Click" Style="{StaticResource AccentButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE896;"/><TextBlock Text="Export CSV"/></StackPanel></Button></StackPanel></Grid>
        <InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False" IsClosable="True"/>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0"><ListView x:Name="SessionsList" SelectionMode="Single"><ListView.Header><Grid Padding="18,12" Background="#2B2A31" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="150"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="ID" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Software" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Canvas / file" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Duration" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="Date &amp; time" FontWeight="SemiBold"/><TextBlock Grid.Column="5" Text="Tags / notes" FontWeight="SemiBold"/></Grid></ListView.Header><ListView.ItemTemplate><DataTemplate><Grid Padding="10,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="150"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Id}" Foreground="{StaticResource TimeFlyMutedTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding App}"/><TextBlock Grid.Column="2" Text="{Binding Canvas}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding Duration}"/><TextBlock Grid.Column="4" Text="{Binding Started}"/><TextBlock Grid.Column="5" Text="{Binding Metadata}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TimeFlyMutedTextBrush}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border>
        <TextBlock x:Name="EmptyText" Grid.Row="2" Text="No sessions match this filter." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TimeFlyMutedTextBrush}" Visibility="Collapsed"/>
    </Grid>
</Page>
