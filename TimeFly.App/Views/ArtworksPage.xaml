<Page
    x:Class="TimeFly.App.Views.ArtworksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="36,28,36,40" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="Artwork Library" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Text="Every canvas TimeFly has seen." Foreground="{StaticResource TimeFlyMutedTextBrush}" FontSize="13" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="240" PlaceholderText="Search artworks…" TextChanged="SearchBox_TextChanged" />
                <Button Click="CleanLibrary_Click" ToolTipService.ToolTip="Consolidate and clean duplicate canvas titles">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE894;" FontSize="13" Foreground="#65D6AD" />
                        <TextBlock Text="Clean Up" />
                    </StackPanel>
                </Button>
                <Button Click="Refresh_Click" ToolTipService.ToolTip="Refresh library">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Grid View of Artwork Cards -->
        <GridView
            x:Name="ArtworkGrid"
            Grid.Row="1"
            SelectionMode="None"
            HorizontalContentAlignment="Stretch">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid ItemWidth="390" ItemHeight="150" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Style="{StaticResource CardStyle}"
                        Width="375"
                        Height="136"
                        Margin="0,0,10,10"
                        Padding="18,14,18,14">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Delete Artwork &amp; History" Click="DeleteArtwork_Click" Tag="{Binding Name}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" Foreground="#EF4444" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Row: Icon + Canvas Name + App Badge -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE790;"
                                    FontSize="16"
                                    Foreground="{StaticResource TimeFlyAccentBrush}"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                <Border
                                    Grid.Column="2"
                                    Background="{StaticResource TimeFlyBadgeBackgroundBrush}"
                                    CornerRadius="6"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding App}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TimeFlyBadgeTextBrush}" />
                                </Border>
                            </Grid>

                            <!-- Middle Row: Total Time & Sessions -->
                            <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding Total}"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TimeFlyTimeBrush}" />
                                <TextBlock
                                    Text="{Binding Sessions}"
                                    FontSize="12"
                                    Foreground="{StaticResource TimeFlyMutedTextBrush}" />
                            </StackPanel>

                            <!-- Bottom Row: Last Modified / Worked -->
                            <TextBlock
                                Grid.Row="2"
                                Text="{Binding LastWorked}"
                                FontSize="11"
                                Foreground="{StaticResource TimeFlySubtleTextBrush}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Empty State -->
        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            Text="No artworks tracked yet. Open your drawing app and start creating ✨"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{StaticResource TimeFlyMutedTextBrush}"
            FontSize="13"
            Visibility="Collapsed" />
    </Grid>
</Page>
