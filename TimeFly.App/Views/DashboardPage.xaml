<Page x:Class="TimeFly.App.Views.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="36,28,36,40" Spacing="20">
            <Grid>
                <StackPanel Spacing="4"><TextBlock Text="Live Tracker" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Automatic focus tracking for your drawing workflow." Foreground="{StaticResource TimeFlyMutedTextBrush}"/></StackPanel>
                <TextBlock x:Name="DateText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TimeFlyMutedTextBrush}"/>
            </Grid>

            <!-- Live Timer Card -->
            <Border Style="{StaticResource CardStyle}" Padding="24">
                <Grid RowSpacing="18" ColumnSpacing="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#302C55"><FontIcon Glyph="&#xEC4A;" FontSize="22" Foreground="{StaticResource TimeFlyAccentBrush}"/></Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="TrackingStatusText" Text="Starting tracker…" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ActiveCanvasText" Text="Scanning active window" Foreground="{StaticResource TimeFlyMutedTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Padding="12,6" CornerRadius="12" Background="#283C36" VerticalAlignment="Center"><TextBlock x:Name="StatusPillText" Text="STANDBY" FontSize="11" FontWeight="SemiBold" Foreground="#65D6AD"/></Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <TextBlock x:Name="LiveTimerText" Text="00:00:00" FontSize="34" FontWeight="SemiBold" FontFamily="Consolas"/>
                        <TextBlock x:Name="CanvasTodayText" Text="0m on this artwork today" Foreground="{StaticResource TimeFlyMutedTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="PauseButton" Click="PauseButton_Click"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE769;"/><TextBlock x:Name="PauseButtonText" Text="Pause"/></StackPanel></Button>
                        <Button Click="ManualButton_Click" Style="{StaticResource AccentButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE710;"/><TextBlock Text="Log session"/></StackPanel></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metrics Row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xF13E;" FontSize="13" Foreground="{StaticResource TimeFlyAccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Daily goal" Foreground="{StaticResource TimeFlyMutedTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="GoalPercentText" Text="0%" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <ProgressBar x:Name="GoalProgress" Height="7" Maximum="100"/>
                        <TextBlock x:Name="TodayTimeText" Text="0m of 2h" FontSize="23" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8F9;" FontSize="13" Foreground="#F8C555" VerticalAlignment="Center"/>
                            <TextBlock Text="Drawing streak" Foreground="{StaticResource TimeFlyMutedTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="StreakText" Text="0 days" FontSize="25" FontWeight="SemiBold"/>
                        <TextBlock Text="Keep creating daily" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            <TextBlock Text="Sessions today" Foreground="{StaticResource TimeFlyMutedTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="SessionsText" Text="0" FontSize="25" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AllTimeText" Text="0m all time" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Native Tablet / Gear Diagnostics Card -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20" Background="#262446" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xED63;" FontSize="18" Foreground="{StaticResource TimeFlyAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="TabletNameText" Text="Scanning drawing gear…" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TabletDetailsText" Text="Checking tablet and driver" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="TabletStateText" Text="SCANNING" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#F8C555"/>
                </Grid>
            </Border>

            <!-- Activity List -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>
                    <Grid Padding="20,16">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE790;" FontSize="15" Foreground="{StaticResource TimeFlyAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Today’s drawing activity" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Click="RefreshButton_Click"><FontIcon Glyph="&#xE72C;" FontSize="13"/></Button>
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource TimeFlyCardBorderBrush}"/>
                    <ListView x:Name="RecentSessionsList" SelectionMode="None" MaxHeight="300">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,8" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding CanvasName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Duration}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptySessionsText" Text="No activity today. Open your drawing app and start creating ✨" Padding="20" Foreground="{StaticResource TimeFlyMutedTextBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
