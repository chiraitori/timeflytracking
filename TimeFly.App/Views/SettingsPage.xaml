<Page
    x:Class="TimeFly.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="36,28,36,40" Spacing="18">
            <!-- Header -->
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings &amp; Preferences" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Tracking, goals, Windows behavior, and hardware diagnostics." Foreground="{StaticResource TimeFlyMutedTextBrush}" FontSize="13" />
                </StackPanel>
            </Grid>

            <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" />

            <!-- 1. Daily Goal -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF13E;" FontSize="16" Foreground="{StaticResource TimeFlyAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Daily Drawing Target" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                            <NumberBox x:Name="GoalBox" Minimum="15" Maximum="720" SmallChange="15" SpinButtonPlacementMode="Compact" Width="120" ValueChanged="GoalBox_ValueChanged" />
                            <TextBlock Text="min" VerticalAlignment="Center" Foreground="{StaticResource TimeFlyMutedTextBrush}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Set your daily drawing goal in minutes. TimeFly tracks your progress ring and daily streaks." Margin="26,0,0,0" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}" />
                </StackPanel>
            </Border>

            <!-- 2. Idle Timeout -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE823;" FontSize="16" Foreground="{StaticResource TimeFlyAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Smart Focus &amp; Standby Detection (AFK / Alt-Tab)" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                            <NumberBox x:Name="IdleBox" Minimum="1" Maximum="30" SmallChange="1" SpinButtonPlacementMode="Compact" Width="100" ValueChanged="IdleBox_ValueChanged" />
                            <TextBlock Text="min" VerticalAlignment="Center" Foreground="{StaticResource TimeFlyMutedTextBrush}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Timer automatically pauses when switching out of your drawing app (Alt-Tab Standby) or when no stylus/input is detected. Sessions are safely finalized when away longer than this duration." Margin="26,0,0,0" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 3. Tracked Apps -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71D;" FontSize="16" Foreground="{StaticResource TimeFlyAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Tracked Drawing Programs" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="AddRunningBtn" Click="AddRunning_Click" ToolTipService.ToolTip="Select from currently running desktop windows">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE756;" FontSize="13" Foreground="#65D6AD" />
                                    <TextBlock Text="Add Running App" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="RunningProcessesFlyout" />
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="TimeFly monitors active canvas titles for these applications. You can add running apps, choose quick presets, or enter a custom process name:" Margin="26,0,0,0" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}" TextWrapping="Wrap" />

                    <!-- Currently Tracked Apps Chips List -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" Margin="26,2,0,2">
                        <StackPanel x:Name="TrackedAppsPanel" Orientation="Horizontal" Spacing="8" />
                    </ScrollViewer>

                    <!-- Quick Add Presets -->
                    <StackPanel Margin="26,0,0,0" Spacing="6">
                        <TextBlock Text="Quick Add Presets:" FontSize="11" Foreground="{StaticResource TimeFlySubtleTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="+ Krita" FontSize="11" Padding="8,3" Click="Preset_Click" Tag="krita.exe" />
                            <Button Content="+ Clip Studio" FontSize="11" Padding="8,3" Click="Preset_Click" Tag="CLIPStudioPaint.exe" />
                            <Button Content="+ Photoshop" FontSize="11" Padding="8,3" Click="Preset_Click" Tag="Photoshop.exe" />
                            <Button Content="+ SAI 2" FontSize="11" Padding="8,3" Click="Preset_Click" Tag="sai2.exe" />
                            <Button Content="+ Aseprite" FontSize="11" Padding="8,3" Click="Preset_Click" Tag="Aseprite.exe" />
                            <Button Content="+ Blender" FontSize="11" Padding="8,3" Click="Preset_Click" Tag="blender.exe" />
                            <Button Content="+ MediBang" FontSize="11" Padding="8,3" Click="Preset_Click" Tag="MediBangPaintPro.exe" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Manual Add Row -->
                    <Grid Margin="26,4,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomAppBox" PlaceholderText="Enter executable name (e.g. rebelle.exe, paint.net.exe)…" KeyDown="CustomAppBox_KeyDown" />
                        <Button Grid.Column="1" Click="AddCustomApp_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="Add App" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Minimize to Tray -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE700;" FontSize="16" Foreground="{StaticResource TimeFlyAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Minimize to System Tray" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleSwitch x:Name="TrayToggle" HorizontalAlignment="Right" OnContent="On" OffContent="Off" Toggled="TrayToggle_Toggled" />
                    </Grid>
                    <TextBlock Text="Keep TimeFly silently running in the Windows system tray when the window is closed." Margin="26,0,0,0" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}" />
                </StackPanel>
            </Border>

            <!-- 5. Drawing Tablet Status (Native Diagnostics Card) -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource TimeFlyIconBoxBrush}">
                                <FontIcon Glyph="&#xED63;" FontSize="16" Foreground="{StaticResource TimeFlyAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Drawing Tablet Status" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Native Windows HID and hardware digitizer diagnostics" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Click="SyncDb_Click" ToolTipService.ToolTip="Sync latest tablet definitions from GitHub">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="#65D6AD" />
                                    <TextBlock x:Name="SyncButtonText" Text="Sync DB" />
                                </StackPanel>
                            </Button>
                            <Button Click="Rescan_Click" ToolTipService.ToolTip="Rescan currently connected USB/HID tablet">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    <TextBlock Text="Rescan Tablet" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource TimeFlyCardBorderBrush}" />

                    <!-- Structured Native Diagnostics Rows -->
                    <Grid RowSpacing="10" Margin="4,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tablet Model -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE929;" FontSize="15" Foreground="{StaticResource TimeFlyAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Graphic Tablet:" FontSize="13" Foreground="{StaticResource TimeFlyMutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="TabletModelText" Text="Scanning tablet..." FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Stylus & Pressure -->
                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEDC6;" FontSize="15" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Stylus Digitizer:" FontSize="13" Foreground="{StaticResource TimeFlyMutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="TabletStylusText" Text="Checking stylus..." FontSize="13" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Driver Daemon -->
                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9CA;" FontSize="15" Foreground="#65D6AD" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Tablet Driver:" FontSize="13" Foreground="{StaticResource TimeFlyMutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="TabletDriverText" Text="Checking driver..." FontSize="13" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Database Engine -->
                        <Grid Grid.Row="3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE82D;" FontSize="15" Foreground="#F8C555" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Database Engine:" FontSize="13" Foreground="{StaticResource TimeFlyMutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="TabletDatabaseText" Text="OpenTabletDriver Engine" FontSize="13" Foreground="{StaticResource TimeFlySubtleTextBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 6. Data Management -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7B8;" FontSize="16" Foreground="{StaticResource TimeFlyAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Data Management" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="DatabasePathText" Margin="26,0,0,0" FontSize="12" Foreground="{StaticResource TimeFlySubtleTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Click="OpenFolder_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE838;" FontSize="13" />
                            <TextBlock Text="Open folder" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 7. About & Credits -->
            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="52" Height="52" CornerRadius="10" Background="{StaticResource TimeFlyIconBoxBrush}" VerticalAlignment="Center">
                        <Image Source="/Assets/app_icon.png" Width="48" Height="48" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="TimeFly • Digital Art Tracker" FontSize="15" FontWeight="SemiBold" />
                            <Border Background="{StaticResource TimeFlyBadgeBackgroundBrush}" CornerRadius="4" Padding="6,1">
                                <TextBlock Text="v0.3.0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TimeFlyBadgeTextBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Created with ❤️ by Chiraitori • Built with .NET 8 and WinUI 3" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}" />
                        <TextBlock Text="App Icon &amp; Artwork courtesy of Pixiv (Artwork ID: 148639751)" FontSize="11" Foreground="{StaticResource TimeFlySubtleTextBrush}" />
                    </StackPanel>

                    <!-- Links Row -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="10" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="CheckUpdates_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="#65D6AD" />
                                    <TextBlock x:Name="CheckUpdateBtnText" Text="Check for Updates" />
                                </StackPanel>
                            </Button>
                            <Button Click="GitHub_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE72D;" FontSize="13" />
                                    <TextBlock Text="GitHub Releases" />
                                </StackPanel>
                            </Button>
                            <Button Click="Author_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE77B;" FontSize="13" />
                                    <TextBlock Text="Developer (Chiraitori)" />
                                </StackPanel>
                            </Button>
                            <Button Click="ArtworkCredit_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                    <TextBlock Text="Pixiv Artwork" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="{StaticResource TimeFlyMutedTextBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
